# These variables must be exported into the process environment.
# This file is documentation; the service does not automatically load .env.
OMNI_HOST=127.0.0.1
OMNI_PORT=47800
OMNI_DATA_DIR=.omnisync
OMNI_ORIGINS=http://127.0.0.1:47800,http://localhost:47800,http://127.0.0.1:5173,http://localhost:5173
# OMNI_TLS_CERT=/absolute/path/to/fullchain.pem
# OMNI_TLS_KEY=/absolute/path/to/private-key.pem
# OMNI_SECURE_PROXY=1
