{
  "name": "omnisync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n service,web \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "omni": "node tools/omni.js",
    "format": "prettier --write \"apps/web/**/*.{ts,tsx,css,html,json,webmanifest}\" \"server/**/*.js\" \"tests/**/*.{js,ts}\" \"tools/*.js\" \"docs/*.md\" README.md CONTRIBUTING.md \"*.{json,ts}\" \".github/**/*.yml\"",
    "test:gtk": "node tools/test-gtk.js",
    "test:macos": "node tools/test-macos.js",
    "recover-owner": "node tools/recover-owner.js"
  },
  "dependencies": {
    "@noble/hashes": "2.0.1",
    "express": "5.1.0",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "ws": "8.22.0",
    "y-indexeddb": "9.0.12",
    "yjs": "13.6.27",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.0",
    "@types/node": "24.7.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.5",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
